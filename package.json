{
  "name": "@getmanza/cli",
  "private": true,
  "version": "1.0.1",
  "description": "Command-line interface for the Manza API.",
  "type": "module",
  "license": "MIT",
  "author": "Manza <hello@get-manza.com>",
  "homepage": "https://github.com/getmanza/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmanza/cli.git"
  },
  "bugs": {
    "url": "https://github.com/getmanza/cli/issues"
  },
  "keywords": [
    "manza",
    "cli",
    "api",
    "invoices",
    "payments"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "go run ./cmd/manza",
    "compile": "go build -trimpath -ldflags='-s -w' -o dist/manza ./cmd/manza",
    "build": "scripts/build",
    "lint": "biome check --error-on-warnings . && go vet . ./cmd/... && test -z \"$(gofmt -l version.go cmd)\"",
    "lint:fix": "biome check --write . && gofmt -w version.go cmd",
    "format": "biome format --write . && gofmt -w version.go cmd",
    "format:check": "biome format . && test -z \"$(gofmt -l version.go cmd)\"",
    "test": "go test . ./cmd/... && bun run compile && bun test",
    "check:all": "bun run lint && bun run test",
    "release": "bin/release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14"
  }
}
