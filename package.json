{
  "name": "@getzazu/cli",
  "version": "0.3.0",
  "description": "Command-line interface for the Zazu API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/getmanza/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmanza/cli.git"
  },
  "bugs": {
    "url": "https://github.com/getmanza/cli/issues"
  },
  "keywords": [
    "zazu",
    "cli",
    "api",
    "invoices",
    "payments"
  ],
  "bin": {
    "zazu": "./bin/zazu.ts"
  },
  "files": [
    "bin/zazu.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "bun ./bin/zazu.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun build --target=bun --outfile=dist/.check/zazu-cli-check ./bin/zazu.ts",
    "compile": "bun build --compile --outfile=dist/zazu ./bin/zazu.ts",
    "build": "scripts/build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:all": "bun run typecheck && bun run lint && bun test",
    "release": "bin/release",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@getzazu/sdk": "^0.3.0"
  }
}
