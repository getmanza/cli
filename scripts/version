#!/usr/bin/env bash
# bin/release adapter: print the current version, or write a new one into every
# tracked file that carries it (package.json only; bin/zazu.ts reads it from
# there, and the npm platform packages take theirs from the tag at publish time).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
  sed -nE 's/^  "version": "([^"]+)",$/\1/p' package.json
  exit 0
fi

sed -i.bak -E "s/^  \"version\": \"[^\"]+\",$/  \"version\": \"$1\",/" package.json
rm -f package.json.bak
