#!/usr/bin/env bash
# Cross-compile the Manza CLI to standalone binaries for every supported
# platform. Each target produces a single self-contained executable that
# bundles the Bun runtime, so users do not need Bun, Node, or Ruby.
#
# Usage:
#   scripts/build              # build all targets
#   scripts/build darwin-arm64 # build a single target

set -euo pipefail

cd "$(dirname "$0")/.."
mkdir -p dist

VERSION="$(bun -e 'console.log(require("./package.json").version)')"

ALL_TARGETS=(
  "darwin-arm64"
  "darwin-x64"
  "linux-x64"
  "linux-arm64"
)

if [[ $# -gt 0 ]]; then
  TARGETS=("$@")
else
  TARGETS=("${ALL_TARGETS[@]}")
fi

for arch in "${TARGETS[@]}"; do
  out="manza-${arch}"
  echo "==> building $out (target=bun-${arch})"
  bun build \
    --compile \
    --minify \
    --bytecode \
    --target="bun-${arch}" \
    --outfile "dist/${out}" \
    bin/manza.ts
done

# Generate SHA256 checksums for this invocation's targets only — `manza-*`
# would also pick up stale binaries from a prior multi-target build.
(
  cd dist
  : > SHA256SUMS
  for arch in "${TARGETS[@]}"; do
    shasum -a 256 "manza-${arch}" >> SHA256SUMS
  done
)

echo "==> built v${VERSION}"
ls -lh dist
