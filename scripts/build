#!/usr/bin/env bash
# Cross-compile the Manza CLI to standalone binaries for every supported
# platform. Each target is a single static Go executable, so users do not
# need Go, Bun, Node, or Ruby.
#
# Usage:
#   scripts/build              # build all targets
#   scripts/build darwin-arm64 # build a single target

set -euo pipefail

cd "$(dirname "$0")/.."
mkdir -p dist

VERSION="$(scripts/version)"

ALL_TARGETS=(
  "darwin-arm64"
  "darwin-x64"
  "linux-x64"
  "linux-arm64"
)

if [[ $# -gt 0 ]]; then
  TARGETS=("$@")
else
  TARGETS=("${ALL_TARGETS[@]}")
fi

for arch in "${TARGETS[@]}"; do
  out="manza-${arch}"
  goos="${arch%-*}"
  goarch="${arch#*-}"
  [[ "$goarch" == "x64" ]] && goarch="amd64"
  echo "==> building $out (GOOS=${goos} GOARCH=${goarch})"
  CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" go build \
    -trimpath \
    -ldflags "-s -w" \
    -o "dist/${out}" \
    ./cmd/manza
done

# Generate SHA256 checksums for this invocation's targets only — `manza-*`
# would also pick up stale binaries from a prior multi-target build.
(
  cd dist
  : > SHA256SUMS
  for arch in "${TARGETS[@]}"; do
    shasum -a 256 "manza-${arch}" >> SHA256SUMS
  done
)

echo "==> built v${VERSION}"
ls -lh dist
