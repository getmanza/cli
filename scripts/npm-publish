#!/usr/bin/env bash
# Publish the Manza CLI to npm using the per-platform package pattern.
#
# Layout:
#   @getmanza/cli                  - parent package (no binary, just JS shims)
#   @getmanza/cli-darwin-arm64     - holds the darwin-arm64 binary
#   @getmanza/cli-darwin-x64       - holds the darwin-x64 binary
#   @getmanza/cli-linux-arm64      - holds the linux-arm64 binary
#   @getmanza/cli-linux-x64        - holds the linux-x64 binary
#
# The parent installs two commands: `manza`, and `zazu`, a deprecated
# alias for all of 1.x that prints a notice and then runs `manza`.
#
# npm only installs the platform package matching the user's OS+CPU
# (via `os` and `cpu` fields). The parent package depends on all four
# as `optionalDependencies` and resolves the right one at runtime.
#
# This is the same pattern used by esbuild, swc, biome, turbo, etc.
#
# Required env: VERSION (e.g. v0.2.0).
# Required input files in dist/: manza-darwin-arm64, manza-darwin-x64,
# manza-linux-arm64, manza-linux-x64.
#
# Auth: each of the five published packages needs an npm trusted-
# publisher binding pointing at this repo's release.yml workflow in
# the `release` GitHub environment. No NPM_TOKEN required — the
# workflow's id-token: write permission is what npm exchanges for a
# short-lived publish credential. See CLAUDE.md for the bookkeeping.
#
# Requires bash 4.0+ (for `declare -A`). GitHub Actions runners ship
# bash 5; on macOS, the system bash is 3.2 and you'll need
# `brew install bash` to run this locally.

set -euo pipefail

# Fail loud if bash is too old, so a local invocation on stock macOS
# fails with a clear message instead of "syntax error" deep in the loop.
if (( BASH_VERSINFO[0] < 4 )); then
  echo "scripts/npm-publish: bash 4+ required (current: ${BASH_VERSION})" >&2
  exit 1
fi

cd "$(dirname "$0")/.."

VERSION="${VERSION#v}"
if [ -z "${VERSION}" ]; then
  echo "::error::VERSION env var required (e.g. v0.2.0)"
  exit 1
fi

mkdir -p npm-dist

# 1. Build the four platform packages.
declare -A PLATFORMS=(
  ["darwin-arm64"]="darwin arm64"
  ["darwin-x64"]="darwin x64"
  ["linux-arm64"]="linux arm64"
  ["linux-x64"]="linux x64"
)

for arch in "${!PLATFORMS[@]}"; do
  read -r os cpu <<< "${PLATFORMS[$arch]}"
  pkg_dir="npm-dist/cli-${arch}"
  mkdir -p "${pkg_dir}/bin"
  cp "dist/manza-${arch}" "${pkg_dir}/bin/manza"
  chmod +x "${pkg_dir}/bin/manza"

  cat > "${pkg_dir}/package.json" <<JSON
{
  "name": "@getmanza/cli-${arch}",
  "version": "${VERSION}",
  "description": "Manza CLI binary for ${arch}",
  "license": "MIT",
  "author": "Manza <hello@get-manza.com>",
  "homepage": "https://github.com/getmanza/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmanza/cli.git"
  },
  "os": ["${os}"],
  "cpu": ["${cpu}"],
  "files": ["bin"],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
JSON

  cat > "${pkg_dir}/README.md" <<MD
# @getmanza/cli-${arch}

Platform binary for [\`@getmanza/cli\`](https://www.npmjs.com/package/@getmanza/cli) on ${os}/${cpu}.

This package only contains the prebuilt binary. You almost certainly want to install \`@getmanza/cli\` instead, which selects the correct platform package automatically.
MD

  echo "==> publishing @getmanza/cli-${arch}@${VERSION}"
  # npx --yes pulls a fresh, OIDC-capable npm (>= 11.5.1). The
  # bundled npm with Node 22's setup-node action is too old; updating
  # it in place via `npm install -g npm@latest` is unreliable when
  # npm is the active process.
  (cd "${pkg_dir}" && npx --yes npm@latest publish)
done

# 2. Build the parent package.
parent_dir="npm-dist/cli"
mkdir -p "${parent_dir}/bin"

cat > "${parent_dir}/package.json" <<JSON
{
  "name": "@getmanza/cli",
  "version": "${VERSION}",
  "description": "Command-line interface for the Manza API",
  "license": "MIT",
  "author": "Manza <hello@get-manza.com>",
  "homepage": "https://github.com/getmanza/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmanza/cli.git"
  },
  "bugs": { "url": "https://github.com/getmanza/cli/issues" },
  "keywords": ["manza", "cli", "api", "invoices", "payments"],
  "bin": { "manza": "bin/manza.js", "zazu": "bin/zazu.js" },
  "files": ["bin"],
  "optionalDependencies": {
    "@getmanza/cli-darwin-arm64": "${VERSION}",
    "@getmanza/cli-darwin-x64": "${VERSION}",
    "@getmanza/cli-linux-arm64": "${VERSION}",
    "@getmanza/cli-linux-x64": "${VERSION}"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
JSON

# Resolver shim - finds the right platform package and execs its binary.
cat > "${parent_dir}/bin/manza.js" <<'JS'
#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const path = require("node:path");

const map = {
  "darwin-arm64": "@getmanza/cli-darwin-arm64",
  "darwin-x64": "@getmanza/cli-darwin-x64",
  "linux-arm64": "@getmanza/cli-linux-arm64",
  "linux-x64": "@getmanza/cli-linux-x64",
};

const key = `${process.platform}-${process.arch}`;
const pkg = map[key];

if (!pkg) {
  console.error(`manza: no prebuilt binary for ${key}.`);
  console.error("Supported: darwin-arm64, darwin-x64, linux-arm64, linux-x64.");
  process.exit(1);
}

let binary;
try {
  binary = path.join(path.dirname(require.resolve(`${pkg}/package.json`)), "bin", "manza");
} catch {
  console.error(`manza: optional dependency ${pkg} was not installed.`);
  console.error("Try reinstalling: npm install -g @getmanza/cli");
  process.exit(1);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
if (result.error) {
  console.error(`manza: failed to launch binary: ${result.error.message}`);
  process.exit(1);
}
process.exit(result.status ?? 0);
JS
chmod +x "${parent_dir}/bin/manza.js"

# Deprecated `zazu` command for all of 1.x: print a notice, then run manza.
cat > "${parent_dir}/bin/zazu.js" <<'JS'
#!/usr/bin/env node
"use strict";

console.error("zazu is deprecated and will be removed in 2.0. Use manza instead.");
require("./manza.js");
JS
chmod +x "${parent_dir}/bin/zazu.js"

# Copy the README into the parent package so it shows on npmjs.com.
cp README.md "${parent_dir}/README.md"

echo "==> publishing @getmanza/cli@${VERSION}"
(cd "${parent_dir}" && npx --yes npm@latest publish)

echo "==> npm publish complete"
